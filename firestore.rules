rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 로그인이 없는 사이트라 누구나 읽고 쓸 수 있다. 대신 장난·실수로 데이터를 통째로 잃지 않게 막는다(2026-10-08).
    //  · 명단은 지울 수 없고, 한 번에 3명 이상 줄일 수 없다
    //  · 일정은 정해진 칸만 쓸 수 있고, 참석 응답을 한 번에 3개 이상 줄일 수 없다
    //  · 지난 경기와 경기 기록이 있는 일정은 지울 수 없다(지울 일이 있으면 관리자 계정으로)
    // 매일 자동 백업(4주 보관)이 따로 돈다.

    // 구성원 명단: hw_team/roster { members: [{id, name, pos, admin}], updatedAt }
    match /hw_team/{docId} {
      allow read: if true;
      allow create, update: if docId == 'roster'
        && request.resource.data.keys().hasOnly(['members', 'updatedAt'])
        && request.resource.data.members is list
        && request.resource.data.members.size() >= 1
        && request.resource.data.members.size() <= 300
        && (resource == null || request.resource.data.members.size() >= resource.data.members.size() - 2);
      allow delete: if false;
    }

    // 일정 · 참석 응답 · 포메이션 · 경기 기록: hw_schedules/{일정}
    match /hw_schedules/{docId} {
      function validDate(d) {
        return d is string && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      }
      // 경기 날짜(한국 시간)가 끝났으면 true
      function isPast(d) {
        let p = d.split('-');
        return timestamp.date(int(p[0]), int(p[1]), int(p[2])) + duration.value(15, 'h') < request.time;
      }
      function validFields() {
        return request.resource.data.keys().hasOnly(['date', 'time', 'venue', 'address', 'opponent', 'lat', 'lng',
            'rsvp', 'guests', 'quarters', 'qn', 'result', 'source', 'updatedAt'])
          && validDate(request.resource.data.date)
          && request.resource.data.get('rsvp', {}) is map
          && request.resource.data.get('quarters', []) is list;
      }
      allow read: if true;
      allow create: if validFields();
      allow update: if validFields()
        && request.resource.data.get('rsvp', {}).size() >= resource.data.get('rsvp', {}).size() - 2;
      allow delete: if !isPast(resource.data.date) && resource.data.get('result', null) == null;
    }

    // 이전 사이트 컬렉션(schedule_attendance, player_positions)은 2026-10-08 정리 — 규칙이 없으면 모두 막힌다.
  }
}
